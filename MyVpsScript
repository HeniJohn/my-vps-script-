# 1. Update system & install required packages
echo -e "${CYAN}[⚡] Phase 1: Installing system packages...${NC}"
apt-get update -y > /dev/null 2>&1
apt-get install -y curl wget tmux dnsutils stunnel4 squid dropbear openssl ufw net-tools screen zip unzip bc python3 > /dev/null 2>&1

# 2. Configure Default Login Banner
echo -e "${CYAN}[⚡] Phase 2: Deploying login banner...${NC}"
cat <<EOF > /etc/issue.net
====================================================================
          WELCOME TO HENI JOHN SECURE CLOUD INFRASTRUCTURE          
               Developed By Henok Yonatan (Heni John)             
====================================================================
EOF

# 3. Configure Dropbear (Port 109)
echo -e "${CYAN}[⚡] Phase 3: Configuring Dropbear backend service...${NC}"
cat <<EOF > /etc/default/dropbear
NO_START=0
DROPBEAR_PORT=109
DROPBEAR_EXTRA_ARGS="-b /etc/issue.net"
DROPBEAR_BANNER="/etc/issue.net"
EOF
systemctl enable dropbear > /dev/null 2>&1
systemctl restart dropbear

# 4. Configure Stunnel (Port 444 -> 109)
echo -e "${CYAN}[⚡] Phase 4: Setting up SSL/TLS Stunnel wrapper...${NC}"
cat <<EOF > /etc/stunnel/stunnel.conf
pid = /var/run/stunnel.pid
cert = /etc/stunnel/stunnel.pem

[ssh]
accept = 444
connect = 127.0.0.1:109
EOF
openssl req -new -x509 -days 3650 -nodes \
    -out /etc/stunnel/stunnel.pem \
    -keyout /etc/stunnel/stunnel.pem \
    -subj "/CN=HeniJohn" 2>/dev/null
sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/stunnel4
systemctl daemon-reload
systemctl enable stunnel4 > /dev/null 2>&1
systemctl restart stunnel4

# 5. Configure Squid Proxy (Port 8080)
echo -e "${CYAN}[⚡] Phase 5: Configuring high-speed Squid proxy...${NC}"
cat <<EOF > /etc/squid/squid.conf
http_port 8080
http_access allow all
EOF
systemctl enable squid > /dev/null 2>&1
systemctl restart squid

# Enforce SSH Security & Banner
sed -i '/Banner/d' /etc/ssh/sshd_config
echo "Banner /etc/issue.net" >> /etc/ssh/sshd_config
systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null

