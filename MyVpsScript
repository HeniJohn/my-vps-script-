# 1. Update system repositories and pull in critical system binaries
echo "[*] Phase 1: Refreshing system software resources..."
apt-get update
apt-get install -y curl wget tmux dnsutils stunnel4 squid openssl

# 2. Safely purge conflicting web server software if it is pre-installed
if systemctl is-active --quiet apache2; then
    echo "[*] Removing conflicting Apache2 web server stack..."
    apt-get --purge remove apache2 -y
fi

# 3. Provision secure Stunnel parameters (Forwarding port 444 into internal SSH)
echo "[*] Phase 2: Deploying encrypted Stunnel configurations..."
cat <<EOF > /etc/stunnel/stunnel.conf
pid = /var/run/stunnel.pid
cert = /etc/stunnel/stunnel.pem

[ssh]
accept = 444
connect = 127.0.0.1:109
EOF

# 4. Generate a unique, long-term SSL/TLS certificate for your secure wrapper
echo "[*] Generating cryptographic SSL certificates (CN=Heni_John)..."
openssl req -new -x509 -days 3650 -nodes \
    -out /etc/stunnel/stunnel.pem \
    -keyout /etc/stunnel/stunnel.pem \
    -subj "/CN=Henok-Yonatan-Heni-John" 2>/dev/null

# 5. Bootstrap the boot framework to enable and spin up the Stunnel daemon
echo "[*] Bootstrapping Stunnel service infrastructure..."
sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/stunnel4
systemctl daemon-reload
systemctl enable stunnel4
systemctl restart stunnel4

# 6. Initialize global Squid proxy profiles handling routing via port 8080
echo "[*] Phase 3: Writing global Squid proxy rules over Port 8080..."
cat <<EOF > /etc/squid/squid.conf
http_port 8080
http_access allow all
EOF
systemctl enable squid
systemctl restart squid

# 7. Modify SSH configurations to output an identifying greeting message banner
echo "[*] Phase 4: Appending secure terminal welcome greeting flags..."
sed -i '/Banner/d' /etc/ssh/sshd_config
echo "Banner /etc/issue.net" >> /etc/ssh/sshd_config

# Craft the persistent text banner shown every time a user logs into the terminal
cat <<EOF > /etc/issue.net
