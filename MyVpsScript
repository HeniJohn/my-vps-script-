EOF
systemctl enable dropbear > /dev/null 2>&1
systemctl restart dropbear
echo -e "${GREEN}✔ Dropbear configured and running on port 109.${NC}\n"

# Phase 3: Configure Stunnel SSL/TLS Wrapper (Port 444 -> 109)
print_status "Phase 3: Setting up encrypted Stunnel wrapper..."
